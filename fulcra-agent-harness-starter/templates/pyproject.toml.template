[project]
name = "{{PROJECT_SLUG}}-harness"
version = "0.1.0"
description = "A small, hand-rolled agent harness for building/running/extending {{PROJECT_NAME}}. Scaffolded from fulcra-agent-harness-starter."
requires-python = ">=3.11"
dependencies = [
    "google-genai>=0.3.0",
    "python-dotenv>=1.0.0",
]

[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[tool.setuptools]
packages = ["harness", "harness.providers"]
