# Python
.venv/
__pycache__/
*.pyc
*.egg-info/

# Env / secrets
.env
*.key

# Harness runtime state (scratchpads, logs from actual runs)
harness/state/runs/

# Python test/runtime artifacts that may appear inside app/ once the
# agent starts running pytest there
app/.pytest_cache/
app/**/__pycache__/

# Runtime session data written by the WebSocket audio streaming endpoint
# (see app/features/websocket_audio_streaming.md) and the processing
# pipeline (app/pipeline.py) -- not source, shouldn't be committed.
app/raw/
app/processed/
app/ideas/

# SvelteKit frontend (recording_frontend.md) -- standard Node/SvelteKit
# build artifacts, never committed.
frontend/node_modules/
frontend/.svelte-kit/
frontend/build/

# OS
.DS_Store
